+    "A2": {"label": "HU/button open floor >= 32", "floors": {"heads_up_button": 32, "small_blind": 32, "button": 32}},
+    "A3": {"label": "HU/button open floor >= 40", "floors": {"heads_up_button": 40, "small_blind": 40, "button": 40}},
