+        f"elapsed_s: {elapsed:.3f}",
+        "",
+        "[stdout]",
+        proc.stdout,
+        "",
+        "[stderr]",
+        proc.stderr,
+    ]
+    write_log(label, "\n".join(log))
+    return {
