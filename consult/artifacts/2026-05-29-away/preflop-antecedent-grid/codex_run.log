+                preflop_info = src.getinfo("src/preflop_lookup.py")
+                for info in src.infolist():
+                    if info.filename == "src/preflop_lookup.py":
+                        continue
+                    dst.writestr(info, src.read(info.filename))
+                dst.writestr(preflop_info, source.encode("utf-8"))
+        diff = "".join(
