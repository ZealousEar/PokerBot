+    cmd = [sys.executable, "-m", "pytest", "tests/edge_cases", "-x"]
+    result = run_command(f"{case}_edge_tests", cmd, cwd=root, env=env)
+    return {
+        "pass": result["exit_code"] == 0,
+        "exit_code": result["exit_code"],
+        "command_log": result["log"],
+    }
