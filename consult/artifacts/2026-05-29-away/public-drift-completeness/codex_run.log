+
+    table_lines = [
+        "| repo | branch | commit | date | bot path | LOC | data files | validator | scheduled | actual | bb/100 scheduled | bb/100 actual | CI | hero errors | opp errors | p99 latency | verdict |",
+        "|---|---|---:|---|---|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---|",
+    ]
