+        existing_doc = json.loads(RESULTS_PATH.read_text())
+        existing = existing_doc.get("results", {})
+    results = dict(existing)
+    for row in inv["bots"]:
+        key = row_key(row)
+        if key in results and not force:
+            continue
+        if row["validator_status"] == "TIMEBOXED_UNUSABLE":
+            prior = PRIOR_MATRIX.get(key)
