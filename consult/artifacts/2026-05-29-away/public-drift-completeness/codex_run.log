+
+def top_level_bot_dirs(repo_dir: Path) -> list[Path]:
+    bots = repo_dir / "bots"
+    if not bots.is_dir():
+        return []
+    return sorted(p for p in bots.iterdir() if (p / "bot.py").is_file())
