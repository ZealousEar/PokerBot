+        "cwd": str(cwd),
+        "started_at": started,
+        "finished_at": now_iso(),
+        "elapsed_s": round(elapsed, 3),
+        "returncode": proc.returncode,
+        "stdout": proc.stdout,
+        "stderr": proc.stderr,
