+    t0 = time.perf_counter()
+    proc = subprocess.run(
+        cmd,
+        cwd=str(cwd),
+        capture_output=True,
+        text=True,
+        timeout=timeout,
+    )
+    elapsed = time.perf_counter() - t0
+    record = {
+        "label": label,
+        "cmd": cmd,
+        "cwd": str(cwd),
+        "started_at": started,
+        "finished_at": now_iso(),
+        "elapsed_s": round(elapsed, 3),
+        "returncode": proc.returncode,
+        "stdout": proc.stdout,
+        "stderr": proc.stderr,
