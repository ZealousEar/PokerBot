+    INVENTORY_PATH.write_text(json.dumps(inv, indent=2, sort_keys=True) + "\n")
+    print(json.dumps({"wrote": str(INVENTORY_PATH), "bots": len(rows), "recent_forks": len(recent_forks)}, indent=2))
