+- `{RESULTS_PATH}`
+- `{INVENTORY_PATH}`
+"""
+    STATUS_PATH.write_text(status)
+    print(json.dumps({"wrote_report": str(REPORT_PATH), "wrote_status": str(STATUS_PATH), "red_rows": len(red_rows)}, indent=2))
