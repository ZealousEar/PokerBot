+def enumerate_inventory() -> dict:
+    ensure_dirs()
+    require_locked_artifacts()
+    cutoff = datetime.now(timezone.utc) - timedelta(hours=72)
+    t_hashes = template_hashes()
+    repo_meta: dict[str, dict] = {}
+    forks_raw = gh_json(
+        "github_forks_uzlez_fullhouse_engine",
