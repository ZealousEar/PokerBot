+    cmd = [
+        "git",
+        "clone",
+        "--depth",
+        "1",
+        "--branch",
+        branch,
+        f"https://github.com/{repo}.git",
+        str(dest),
+    ]
+    rec = run_cmd(f"clone_{repo}_{branch}", cmd, timeout=300)
+    if rec["returncode"] != 0:
+        return None
+    return dest
