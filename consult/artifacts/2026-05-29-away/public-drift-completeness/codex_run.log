+                sched=r.get("scheduled_hands", "n/a"),
+                actual=r.get("actual_hands", "n/a"),
+                mean_s=fmt_float(r.get("mean_bb100_scheduled")),
+                mean_a=fmt_float(r.get("mean_bb100_actual")),
+                ci=ci,
+                he=r.get("hero_errors", "n/a"),
+                oe=r.get("opponent_errors", "n/a"),
