+STATUS_PATH = ART / "STATUS_BLOCK.md"
+
+STANDARD_BOT_NAMES = {"template", "aggressor", "mathematician", "shark", "ref_bot_2"}
+TARGET_REPOS = {
+    "TobyCoad/fullhouse-engine": {"branch": None, "family": "toby"},
