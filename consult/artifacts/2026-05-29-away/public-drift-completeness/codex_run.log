+            "| {repo} | {branch} | `{commit}` | {date} | `{bot}` | {loc} | {data_count} | {validator} | {sched} | {actual} | {mean_s} | {mean_a} | {ci} | {he} | {oe} | {p99} | {verdict} |".format(
+                repo=r.get("repo", ""),
+                branch=r.get("branch", ""),
