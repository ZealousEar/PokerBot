+def template_hashes() -> set[str]:
+    hashes = set()
+    for name in STANDARD_BOT_NAMES:
+        path = ENGINE / "bots" / name / "bot.py"
+        if path.is_file():
+            hashes.add(sha256(path))
+    return hashes
