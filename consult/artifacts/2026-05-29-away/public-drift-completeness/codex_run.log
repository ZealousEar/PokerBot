+            runs.append(run_schedule(row, "escalate_b242", extra, 242, match_len, 1000, max_seconds))
+        combined = combine_runs(row, runs, new_threat)
+        combined["escalation_reasons"] = reasons
+        results[key] = combined
+        RESULTS_PATH.write_text(
