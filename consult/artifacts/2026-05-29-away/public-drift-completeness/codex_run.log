+            add_candidate(rows, seen, row)
+
+        if family == "toby":
+            for bot_dir in custom_dirs:
+                add_dir(bot_dir, "Toby custom top-level bot")
+        elif family == "mehedi":
+            for bot_dir in custom_dirs:
+                add_dir(bot_dir, "Mehedi custom top-level bot")
+        elif family == "pav":
+            for bot_dir in bot_dirs:
