+                    "vladimir live vlad",
+                    default_branch,
+                    any(r["repo"] == repo for r in recent_forks),
+                    t_hashes,
+                )
+                if not (bot_dir / "data" / "gto_strategy.npz").is_file():
+                    local_model = ROOT / "ext" / "public-bots" / "vladimir" / "bots" / "vlad" / "data" / "gto_strategy.npz"
+                    row["validator_status"] = "TIMEBOXED_UNUSABLE"
+                    row["notes"] = (
