+def make_bot_row(
+    repo: str,
+    branch: str,
+    repo_dir: Path,
+    bot_dir: Path,
+    family: str,
+    inclusion_reason: str,
+    default_branch: str,
+    recent_fork: bool,
+    template_hash_set: set[str],
+) -> dict:
+    bot_py = bot_dir / "bot.py"
+    bot_sha = sha256(bot_py)
+    return {
+        "repo": repo,
+        "branch": branch,
+        "default_branch": default_branch,
