+"""
+    REPORT_PATH.write_text(report)
+
+    red_summary = "\n".join(
+        f"- {r['repo']} {r['bot_path']}: {r['verdict']} mean={fmt_float(r.get('mean_bb100_scheduled'))} CI=[{fmt_float(r.get('ci_low'))},{fmt_float(r.get('ci_high'))}]"
+        for r in red_rows
+    ) or "- none"
