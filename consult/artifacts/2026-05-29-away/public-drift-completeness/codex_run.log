+def fmt_float(x, digits: int = 2) -> str:
+    if x is None:
+        return "n/a"
+    return f"{x:.{digits}f}"
+
+
+def verdict_base(v: str) -> str:
+    if v.startswith("RED"):
+        return "RED"
+    if v.startswith("GREEN"):
+        return "GREEN"
+    if v.startswith("AMBER"):
+        return "AMBER"
+    if v.startswith("TIMEBOXED"):
+        return "TIMEBOXED"
+    return v
+
