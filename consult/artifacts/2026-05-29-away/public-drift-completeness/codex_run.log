+def git_one(repo_dir: Path, label: str, args: list[str]) -> str:
+    rec = run_cmd(f"{label}_{repo_dir.name}", ["git", *args], cwd=repo_dir, timeout=60)
+    if rec["returncode"] != 0:
+        return ""
+    return rec["stdout"].strip()
