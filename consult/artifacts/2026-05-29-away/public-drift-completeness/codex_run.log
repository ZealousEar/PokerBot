+        "|---|---|---:|---|---|---:|---:|---|---:|---:|---:|---:|---:|---:|---:|---:|---|",
+    ]
+    bot_by_key = {row_key(b): b for b in inv["bots"]}
+    for r in rows:
+        key = f"{r['repo']}|{r['branch']}|{r['bot_path']}"
+        b = bot_by_key.get(key, {})
