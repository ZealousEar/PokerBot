+        return row
+    if not row.get("opponent_zip"):
+        row["validator_status"] = "UNUSABLE"
+        return row
+    label = f"validator_{row['repo']}_{row['branch']}_{row['bot_name']}"
+    rec = run_cmd(
+        label,
+        [sys.executable, str(ENGINE / "sandbox" / "validator.py"), row["opponent_zip"], "--json"],
+        timeout=120,
+    )
