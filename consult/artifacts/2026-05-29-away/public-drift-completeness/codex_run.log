+
+
+ART = Path(__file__).resolve().parent
+ROOT = ART.parents[3]
+ENGINE = ROOT / "ext" / "fullhouse-engine"
+HERO_ZIP = ROOT / "submissions" / "v_final.zip"
+BEST_GREEN_ZIP = ROOT / "submissions" / "best_green.zip"
