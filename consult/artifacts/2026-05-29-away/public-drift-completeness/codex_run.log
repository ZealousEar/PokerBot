+        "verdict": "GREEN",
+        "source": "2026-05-29 public-repo-drift prior matrix",
+    },
+    "vladimirfilip/fullhouse-engine|main|bots/vlad/bot.py": {
+        "head_sha": "1fbf389224eed471a54768898acdecb093a2bd6e",
+        "scheduled_hands": 400000,
+        "actual_hands": 20081,
+        "mean_bb100_scheduled": 3.70,
