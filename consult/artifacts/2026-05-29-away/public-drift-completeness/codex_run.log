+        for r in red_rows
+    )
+    red_public_names = ", ".join(f"{r['repo']} {r['bot_path']}" for r in red_rows) or "none"
+
+    answers = {
+        "pav_red": bool(pav_red),
+        "only_toby_mehedi_red": only_toby_mehedi_red,
