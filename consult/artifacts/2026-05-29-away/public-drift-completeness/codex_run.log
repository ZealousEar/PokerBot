+        default_branch = meta.get("default_branch") or "main"
+        branch = spec.get("branch") or default_branch
+        repo_meta[repo] = {
+            "repo": repo,
+            "default_branch": default_branch,
+            "branch": branch,
+            "pushed_at": meta.get("pushed_at"),
