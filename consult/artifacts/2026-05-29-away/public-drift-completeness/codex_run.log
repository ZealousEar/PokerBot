+                add_candidate(rows, seen, row)
+        elif family == "famadeo":
+            bot_dir = repo_dir / "bots" / "codex_holdem"
+            if (bot_dir / "bot.py").is_file():
+                add_dir(bot_dir, "famadeo unchanged-SHA check")
+        elif family == "neel":
