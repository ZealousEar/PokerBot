+            continue
+        prior = PRIOR_MATRIX.get(key)
+        unchanged = bool(prior and prior["head_sha"] == row["latest_commit"])
+        if unchanged and not row["h2h_required"]:
+            results[key] = {
+                "repo": row["repo"],
+                "branch": row["branch"],
+                "latest_commit": row["latest_commit"],
+                "commit_date": row["commit_date"],
