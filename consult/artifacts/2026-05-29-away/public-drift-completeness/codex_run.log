+            continue
+        family = spec["family"]
+        bot_dirs = top_level_bot_dirs(repo_dir)
+        custom_dirs = [p for p in bot_dirs if p.name not in STANDARD_BOT_NAMES]
+        repo_rows.append(
+            {
+                "repo": repo,
