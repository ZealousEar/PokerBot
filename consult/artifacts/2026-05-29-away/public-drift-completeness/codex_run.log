+                "commit_date": git_one(repo_dir, "repo_commit_date", ["show", "-s", "--format=%cI", "HEAD"]),
+                "top_level_bot_dirs": [p.name for p in bot_dirs],
+                "custom_bot_dirs": [p.name for p in custom_dirs],
