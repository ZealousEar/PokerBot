+        "opponent_zip_info": helper.describe_zip(OPP_ZIP),
+        "opponent_repo": "Mehedi-dev-2404/fullhouse-engine",
+        "opponent_head_sha": "aa14a35a4f185f8608ae962aef17a7c620909a4b",
+        "opponent_bot_path": "bots/mybot/bot.py",
