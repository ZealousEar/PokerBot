+def run(args: argparse.Namespace) -> dict:
+    LANE_DIR.mkdir(parents=True, exist_ok=True)
+    samples = []
+    match_rows = []
+    hand_meta = {}
+    scheduled_total = 0
+    actual_total = 0
+    hero_errors = 0
