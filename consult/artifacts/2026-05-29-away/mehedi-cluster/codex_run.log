+        "actual_hands": actual_total,
+        "scheduled_bb_per_100": bb100(sum(s["chip_delta"] for s in samples), scheduled_total),
+        "actual_bb_per_100": bb100(sum(s["chip_delta"] for s in samples), actual_total),
+        "ci": ci,
+        "hero_errors": hero_errors,
