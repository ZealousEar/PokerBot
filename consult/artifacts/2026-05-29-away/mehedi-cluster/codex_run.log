+
+BOOTSTRAP_ITERS = 5000
+CI_ALPHA = 0.05
+MATCH_RE = re.compile(r"_s(?P<base>\d+)_k(?P<k>\d+)_seed(?P<seed>\d+)_o(?P<orientation>\d+)$")
