+    two_tone = bool(suits) and 2 <= max_suit < len(suits)
+    values = sorted(_RANK_VALUE.get(rank, 0) for rank in ranks)
+    static = len(values) < 3 or values[-1] - values[0] > 5
+    return paired, two_tone, static
