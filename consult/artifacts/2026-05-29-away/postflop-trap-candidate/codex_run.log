+    return paired, two_tone, static
+
+
+def _has_straight(cards: list, board: list) -> bool:
+    values = {_RANK_VALUE.get(_rank(card), 0) for card in cards + board}
+    values.discard(0)
+    if 14 in values:
+        values.add(1)
+    hero_values = {_RANK_VALUE.get(_rank(card), 0) for card in cards}
