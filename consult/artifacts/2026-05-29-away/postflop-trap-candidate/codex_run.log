@@ -0,0 +1,102 @@
+"""River postflop-trap candidate edge tests."""
+
+from src import bot
+from src.postflop import decide_postflop
+
+
+VALID = {"fold", "check", "call", "raise", "all_in"}
+
+
+def state(**overrides):
+    base = {
+        "type": "action_request",
+        "hand_id": "postflop_trap_candidate",
+        "street": "river",
+        "seat_to_act": 0,
+        "pot": 1800,
+        "community_cards": ["As", "7s", "2d", "Tc", "3h"],
+        "current_bet": 0,
+        "min_raise_to": 100,
+        "amount_owed": 0,
+        "can_check": True,
+        "your_cards": ["8c", "6d"],
+        "your_stack": 9000,
+        "your_bet_this_street": 0,
+        "players": [
+            {"seat": 0, "stack": 9000, "is_folded": False},
+            {"seat": 1, "stack": 9000, "is_folded": False},
+        ],
+        "action_log": [],
+    }
+    base.update(overrides)
+    return base
+
+
+def assert_legal(action, game_state):
+    assert isinstance(action, dict)
+    assert action.get("action") in VALID
+    if action["action"] == "check":
+        assert game_state.get("can_check")
+    if action["action"] == "raise":
+        assert isinstance(action.get("amount"), int)
+        assert action["amount"] >= game_state["min_raise_to"]
+
+
+def test_river_free_wet_static_weak_hand_checks_not_two_thirds_raise():
+    game_state = state()
+
+    assert decide_postflop(game_state) == {"action": "check"}
+
+
+def test_river_free_clear_value_preserves_value_raise():
+    game_state = state(
+        community_cards=["Ah", "7d", "2c", "As", "3h"],
+        your_cards=["Ad", "Kd"],
+    )
+    action = decide_postflop(game_state)
+
+    assert action == {"action": "raise", "amount": 1200}
+
+
+def test_river_paired_two_tone_static_after_investment_calls_large_bet():
+    game_state = state(
+        community_cards=["Ah", "7h", "2d", "Tc", "7s"],
+        your_cards=["Kc", "Qd"],
+        pot=6000,
+        current_bet=3900,
+        min_raise_to=7800,
+        amount_owed=3000,
+        can_check=False,
+        your_bet_this_street=900,
+    )
+
+    assert decide_postflop(game_state) == {"action": "call"}
+
+
+def test_patched_outputs_are_legal_through_public_decide():
+    cases = [
+        state(),
+        state(community_cards=["Ah", "7d", "2c", "As", "3h"], your_cards=["Ad", "Kd"]),
+        state(
+            community_cards=["Ah", "7h", "2d", "Tc", "7s"],
+            your_cards=["Kc", "Qd"],
+            pot=6000,
+            current_bet=3900,
+            min_raise_to=7800,
+            amount_owed=3000,
+            can_check=False,
+            your_bet_this_street=900,
+        ),
+        state(
+            community_cards=["Ah", "Kd", "2c", "Ts", "3h"],
+            your_cards=["8s", "6s"],
+            pot=1200,
+            current_bet=1800,
+            min_raise_to=3600,
+            amount_owed=1800,
+            can_check=False,
+        ),
+    ]
+
+    for game_state in cases:
+        assert_legal(bot.decide(game_state), game_state)

