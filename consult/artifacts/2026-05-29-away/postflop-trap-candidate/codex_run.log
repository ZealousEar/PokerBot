+"""River postflop-trap candidate edge tests."""
+
+from src import bot
+from src.postflop import decide_postflop
+
+
+VALID = {"fold", "check", "call", "raise", "all_in"}
+
+
+def state(**overrides):
+    base = {
+        "type": "action_request",
+        "hand_id": "postflop_trap_candidate",
+        "street": "river",
+        "seat_to_act": 0,
+        "pot": 1800,
+        "community_cards": ["As", "7s", "2d", "Tc", "3h"],
+        "current_bet": 0,
+        "min_raise_to": 100,
+        "amount_owed": 0,
+        "can_check": True,
+        "your_cards": ["8c", "6d"],
+        "your_stack": 9000,
+        "your_bet_this_street": 0,
+        "players": [
+            {"seat": 0, "stack": 9000, "is_folded": False},
+            {"seat": 1, "stack": 9000, "is_folded": False},
+        ],
+        "action_log": [],
+    }
+    base.update(overrides)
+    return base
+
+
+def assert_legal(action, game_state):
+    assert isinstance(action, dict)
+    assert action.get("action") in VALID
+    if action["action"] == "check":
+        assert game_state.get("can_check")
+    if action["action"] == "raise":
+        assert isinstance(action.get("amount"), int)
+        assert action["amount"] >= game_state["min_raise_to"]
+
+
+def test_river_free_wet_static_weak_hand_checks_not_two_thirds_raise():
+    game_state = state()
+
+    assert decide_postflop(game_state) == {"action": "check"}
+
+
+def test_river_free_clear_value_preserves_value_raise():
+    game_state = state(
+        community_cards=["Ah", "7d", "2c", "As", "3h"],
+        your_cards=["Ad", "Kd"],
+    )
+    action = decide_postflop(game_state)
+
+    assert action == {"action": "raise", "amount": 1200}
+
+
