+            pot=1200,
+            current_bet=1800,
+            min_raise_to=3600,
+            amount_owed=1800,
+            can_check=False,
+        ),
+    ]
+
+    for game_state in cases:
+        assert_legal(bot.decide(game_state), game_state)

