+    {"street": "preflop", "actor": "anon_1", "action": "call", "amount": 100, "position": "middle"},
+    {"street": "preflop", "actor": "anon_3", "action": "raise", "amount": 400, "position": "cutoff"},
+    {"street": "flop", "actor": "anon_3", "action": "raise", "amount": 700, "board": ["Qh", "8h", "2c"], "can_check": true, "position": "cutoff"},
+    {"street": "turn", "actor": "anon_3", "action": "raise", "amount": 1300, "board": ["Qh", "8h", "2c", "3d"], "can_check": true, "position": "cutoff"},
+    {"street": "river", "actor": "anon_5", "action": "call", "to_call": 900, "board": ["Qh", "8h", "2c", "3d", "7s"], "can_check": false, "position": "big_blind"}
+  ]
+}
