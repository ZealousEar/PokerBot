+            f"{fmt_num(stats['p10'])} | {fmt_num(stats['p50'])} | {fmt_num(stats['p90'])} | "
+            f"{fmt_num(stats['mean'])} | {fmt_num(stats['stdev'])} | "
+            f"{fmt_num((data['bust_rate'] or 0) * 100, 1)}% | {hero_errors} | "
+            f"{fmt_num(data['hero_p99_decide_latency_ms'], 3)} |"
+        )
+
