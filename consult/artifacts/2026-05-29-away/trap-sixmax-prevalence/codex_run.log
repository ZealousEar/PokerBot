+        f"- Outputs: `{relative(LANE_DIR / 'TRAP_SIXMAX_REPORT.md')}`, `{relative(LANE_DIR / 'RESULTS.json')}`, `{relative(LANE_DIR / 'matches.jsonl')}`.",
