+PUBLIC_PATCH_DIR = ROOT / "consult" / "artifacts" / "2026-05-29-public-drift-patch"
+PUBLIC_SAT_DIR = ROOT / "consult" / "artifacts" / "2026-05-28-public-saturation"
+
