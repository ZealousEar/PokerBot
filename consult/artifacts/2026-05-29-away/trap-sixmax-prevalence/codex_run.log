+    protected_after = validate_protected_shas("after")
+    (LANE_DIR / "protected_sha_after.json").write_text(json.dumps(protected_after, indent=2, sort_keys=True) + "\n")
+    summary = write_outputs(
+        records,
+        args.compositions,
+        seeds,
+        args.hands,
