+"""Trap-bot six-max prevalence stress test for locked v_final.zip.
+
+All generated artifacts stay in this lane directory. The hero is always the
+locked zip in submissions/v_final.zip; source-tree src/ is never imported as
+the hero strategy.
+"""
+
+from __future__ import annotations
+
+import argparse
+import concurrent.futures
+import hashlib
+import json
+import math
+import os
+import shutil
+import statistics
+import sys
+import threading
+import time
