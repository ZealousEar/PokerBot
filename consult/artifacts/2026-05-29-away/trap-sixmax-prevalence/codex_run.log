+    records: dict[tuple[str, int], dict],
+    compositions: list[str],
+    seeds: list[int],
+    hands: int,
+    seed_base: int,
+    opponent_manifest: dict[str, dict],
+    protected_before: dict[str, str],
+    protected_after: dict[str, str],
