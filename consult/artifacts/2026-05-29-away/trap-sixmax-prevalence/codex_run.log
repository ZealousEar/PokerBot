+        f"opp_err={record['opponent_action_errors']}/{record['opponent_decisions']} "
+        f"p99_ms={fmt_num(record['hero_p99_decide_latency_ms'], 3)} "
+        f"dur={record['duration_s']}s",
+        flush=True,
+    )
