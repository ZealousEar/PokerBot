+    "ref_bot_2": ENGINE_DIR / "bots" / "ref_bot_2",
+}
+
+COMPOSITIONS = {
+    "C0_BASELINE_RECHECK": [
+        "hero",
+        "template",
+        "aggressor",
+        "mathematician",
+        "shark",
+        "ref_bot_2",
