+        args.seed_base,
+        opponent_manifest,
+        protected_before,
+        protected_after,
+    )
+    print(f"[trap-sixmax] wrote {LANE_DIR / 'RESULTS.json'}")
+    print(f"[trap-sixmax] verdict={summary['top_line_verdict']}")
+    for name, data in summary["compositions"].items():
