+            f"| {name} | {data['color']} | {fmt_num(stats['p10'])} | {fmt_num(stats['p25'])} | "
+            f"{fmt_num(stats['p50'])} | {fmt_num(stats['p75'])} | {fmt_num(stats['p90'])} | "
+            f"{fmt_num(stats['mean'])} | {fmt_num(stats['stdev'])} | "
