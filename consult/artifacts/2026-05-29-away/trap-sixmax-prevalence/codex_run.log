+    "pav_skantbot7_6": PUBLIC_DRIFT_DIR / "opponent_zips" / "pav_skantbot7_6.zip",
+    "stoppedtime24_mybot": PUBLIC_DRIFT_DIR / "opponent_zips" / "stoppedtime24_mybot.zip",
