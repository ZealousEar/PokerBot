+        f"jobs={args.jobs} pending={len(tasks)} resumed={len(records)}",
+        flush=True,
+    )
+
+    timer = DecisionTimer()
+    timer.install()
+    try:
+        if args.jobs <= 1:
+            for composition, seed in tasks:
