+ROOT = LANE_DIR.parents[3]
+ENGINE_DIR = ROOT / "ext" / "fullhouse-engine"
+EXPECTED_LOCKED_SHA = "e4b4a8f11f801ecef2eca53629241e83cc9bace8ec74004f19368375f22d9598"
