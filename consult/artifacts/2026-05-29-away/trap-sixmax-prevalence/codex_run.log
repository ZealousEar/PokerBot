+def validate_protected_shas(stage: str) -> dict[str, str]:
+    shas = protected_shas()
+    bad = {path: sha for path, sha in shas.items() if sha != EXPECTED_LOCKED_SHA}
+    if bad:
+        raise RuntimeError(f"protected SHA mismatch at {stage}: {bad}")
+    return shas
