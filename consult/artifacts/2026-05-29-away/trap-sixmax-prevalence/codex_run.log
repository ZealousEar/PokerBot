+
+def protected_shas() -> dict[str, str]:
+    paths = [
+        ROOT / "submissions" / "v_final.zip",
+        ROOT / "submissions" / "best_green.zip",
+    ]
+    return {relative(path): sha256_file(path) for path in paths}
+
