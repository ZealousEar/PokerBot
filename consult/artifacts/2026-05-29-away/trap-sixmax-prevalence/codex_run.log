+    "vladimir": PUBLIC_SAT_DIR / "opponent_zips" / "vladimir.zip",
+    "old_dominic": PUBLIC_SAT_DIR / "opponent_zips" / "dominic.zip",
+}
+
+REFERENCE_DIRS = {
