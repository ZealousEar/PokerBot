+        bot_paths[name] = dest
+        manifest[name] = {
+            "source": relative(src_zip),
+            "path": relative(dest),
+            "sha256": sha256_file(dest),
+            "kind": "copied_zip",
+        }
+
+    for name, src_dir in REFERENCE_DIRS.items():
+        dest = out_dir / f"{name}.zip"
+        if force or not dest.exists():
