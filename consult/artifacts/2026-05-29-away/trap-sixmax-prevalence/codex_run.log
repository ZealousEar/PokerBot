+            f"hero_err={fmt_num((data['hero_error_rate'] or 0) * 100, 3)}% "
+            f"opp_err={fmt_num((data['opponent_error_rate'] or 0) * 100, 3)}% "
+            f"p99_ms={fmt_num(data['hero_p99_decide_latency_ms'], 3)}",
