@@ -0,0 +1,49 @@
+"""Lane A postflop trap guard regression tests."""
+
+from src.postflop import decide_postflop
+
+
+_RIVER_STATIC_TWO_TONE = {
+    "type": "action_request",
+    "street": "river",
+    "pot": 600,
+    "community_cards": ["2s", "2h", "7s", "9d", "Qc"],
+    "current_bet": 0,
+    "min_raise_to": 100,
+    "amount_owed": 0,
+    "can_check": True,
+    "your_stack": 9400,
+    "your_bet_this_street": 0,
+}
+
+
+def test_weak_hand_checks_static_two_tone_river_instead_of_autoraising():
+    state = dict(_RIVER_STATIC_TWO_TONE, your_cards=["Ah", "Kd"])
+
+    assert decide_postflop(state) == {"action": "check"}
+
+
+def test_clear_value_can_call_paired_static_two_tone_river_after_investment():
+    state = dict(
+        _RIVER_STATIC_TWO_TONE,
+        can_check=False,
+        current_bet=700,
+        amount_owed=500,
+        your_bet_this_street=200,
+        your_cards=["As", "Ac"],
+    )
+
+    assert decide_postflop(state) == {"action": "call"}
+
+
+def test_weak_hand_folds_large_river_bet_without_clear_value():
+    state = dict(
+        _RIVER_STATIC_TWO_TONE,
+        can_check=False,
+        current_bet=700,
+        amount_owed=500,
+        your_bet_this_street=200,
+        your_cards=["Ah", "Kd"],
+    )
+
+    assert decide_postflop(state) == {"action": "fold"}
