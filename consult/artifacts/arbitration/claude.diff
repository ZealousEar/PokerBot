+
+def test_action_request_with_match_action_log():
+    """Engine injects match_action_log; opponent model should consume it
+    without raising."""
+    log = []
+    for h in range(35):  # past warmup threshold
+        log.append({"hand_num": h, "seat": 1, "bot_id": "op", "action": "call", "amount": 100})
+    state = {
