+"""Synthetic biased opponents for G5 ablation: tight/loose × passive/aggressive.
+
+Each opponent is a callable `decide(state) -> dict` that conforms to the
+engine's `bot.py` contract. The ablation script in tools/benchmark.py uses
+these archetypes (via TEMPLATES proxy) to measure the overlay's gain.
+
+Plain pytest assertions also verify they return legal actions.
+"""
+import random
+
+_VALID = {"fold", "check", "call", "raise", "all_in"}
+
+
+def _legal(a):
+    assert isinstance(a, dict)
+    assert a.get("action") in _VALID
+    if a["action"] == "raise":
+        assert "amount" in a
+
+
+def tight_passive(state: dict) -> dict:
+    """Plays only premium hands; never raises postflop. Folds to any bet > pot/3."""
+    cards = state.get("your_cards", [])
+    can_check = state.get("can_check", False)
+    pot = state.get("pot", 0)
+    owed = state.get("amount_owed", 0)
+    if len(cards) == 2:
+        ranks = sorted([c[0] for c in cards], reverse=True)
+        is_premium = (ranks[0] == ranks[1] and ranks[0] in "AKQJ") \
+                     or (set(ranks) == {"A", "K"})
+        if is_premium:
+            if can_check:
+                return {"action": "check"}
+            return {"action": "call"}
+    if can_check:
+        return {"action": "check"}
+    if owed * 3 < pot:
+        return {"action": "call"}
+    return {"action": "fold"}
+
+
+def loose_passive(state: dict) -> dict:
+    """Calls almost anything cheap; never raises."""
+    can_check = state.get("can_check", False)
+    pot = state.get("pot", 0)
+    owed = state.get("amount_owed", 0)
+    stack = state.get("your_stack", 0)
+    if can_check:
+        return {"action": "check"}
+    if owed < min(stack, pot):  # call if it costs less than the pot
+        return {"action": "call"}
+    return {"action": "fold"}
+
+
+def tight_aggressive(state: dict) -> dict:
+    """Premium only; raises 3x when entering pots."""
+    cards = state.get("your_cards", [])
+    can_check = state.get("can_check", False)
+    pot = state.get("pot", 0)
+    owed = state.get("amount_owed", 0)
+    min_raise = state.get("min_raise_to", 200)
+    stack = state.get("your_stack", 0)
+    my_bet = state.get("your_bet_this_street", 0)
+    if len(cards) == 2:
+        ranks = sorted([c[0] for c in cards], reverse=True)
+        is_premium = (ranks[0] == ranks[1] and ranks[0] in "AKQJT") \
+                     or (set(ranks) == {"A", "K"}) \
+                     or (set(ranks) == {"A", "Q"})
+        if is_premium:
+            target = max(min_raise, min(min_raise * 3, stack + my_bet))
+            if target - my_bet >= stack:
+                return {"action": "all_in"}
+            return {"action": "raise", "amount": target}
+    if can_check:
+        return {"action": "check"}
+    return {"action": "fold"}
+
+
+def loose_aggressive(state: dict) -> dict:
+    """Raises ~50 % of the time; calls otherwise."""
+    can_check = state.get("can_check", False)
+    pot = state.get("pot", 0)
+    owed = state.get("amount_owed", 0)
+    min_raise = state.get("min_raise_to", 200)
+    stack = state.get("your_stack", 0)
+    my_bet = state.get("your_bet_this_street", 0)
+    seed_src = (str(state.get("hand_id", "")) + str(state.get("street", "")))
+    rng = random.Random(hash(seed_src) & 0xFFFFFFFF)
+    if rng.random() < 0.55:
+        target = max(min_raise, min(min_raise * 2, stack + my_bet))
+        if target - my_bet >= stack:
+            return {"action": "all_in"}
+        return {"action": "raise", "amount": target}
+    if can_check:
+        return {"action": "check"}
+    return {"action": "call"}
+
+
+BIASED = {
+    "tight_passive": tight_passive,
+    "loose_passive": loose_passive,
+    "tight_aggressive": tight_aggressive,
+    "loose_aggressive": loose_aggressive,
+}
+
+
+def _state(**overrides):
+    base = {
+        "type": "action_request",
+        "hand_id": "biased_test_001",
+        "street": "preflop",
+        "seat_to_act": 0,
+        "pot": 150,
+        "community_cards": [],
+        "current_bet": 100,
+        "min_raise_to": 200,
+        "amount_owed": 100,
+        "can_check": False,
+        "your_cards": ["As", "Kh"],
+        "your_stack": 9900,
+        "your_bet_this_street": 0,
+        "players": [],
+        "action_log": [],
+    }
+    base.update(overrides)
+    return base
+
+
+def test_all_biased_return_legal_actions():
+    for name, fn in BIASED.items():
+        for hole in [["As", "Ah"], ["7c", "2d"], ["Jh", "Th"], ["8s", "8d"]]:
+            _legal(fn(_state(your_cards=hole)))
+            _legal(fn(_state(your_cards=hole, can_check=True, current_bet=0,
+                             amount_owed=0, street="flop",
+                             community_cards=["7s", "Td", "2h"])))
+
+
+def test_loose_aggressive_actually_raises_often():
+    """Sanity: loose_aggressive should raise at least 40 % of decisions."""
+    rng = random.Random(1)
+    n_raise = 0
+    n = 200
+    for i in range(n):
+        s = _state(hand_id=f"laggy_{i}", street="preflop")
+        a = loose_aggressive(s)
+        if a["action"] in ("raise", "all_in"):
+            n_raise += 1
+    assert n_raise / n >= 0.40, f"loose_aggressive raise freq {n_raise / n:.2f}"
