+"""Every code path through `decide()` must return an action ∈
+{fold, check, call, raise, all_in}; raise must include 'amount'.
+
+Game states cover engine `TEST_STATES`, weird input shapes, and a sweep of
+synthetic streets / stacks to catch regressions.
+"""
+import random
+
+from src import bot
+
+_VALID = {"fold", "check", "call", "raise", "all_in"}
+
+
+def _legal(action):
+    assert isinstance(action, dict), f"not a dict: {action!r}"
+    assert action.get("action") in _VALID, f"illegal action: {action!r}"
+    if action["action"] == "raise":
+        assert "amount" in action, f"raise missing amount: {action!r}"
+        assert isinstance(action["amount"], int), f"amount not int: {action!r}"
+
+
+def _state(**overrides):
+    base = {
+        "type": "action_request",
+        "hand_id": "test_0001",
+        "street": "preflop",
+        "seat_to_act": 0,
+        "pot": 150,
+        "community_cards": [],
+        "current_bet": 100,
+        "min_raise_to": 200,
+        "amount_owed": 100,
+        "can_check": False,
+        "your_cards": ["As", "Kh"],
+        "your_stack": 9900,
+        "your_bet_this_street": 0,
+        "players": [
+            {"seat": 0, "bot_id": "me", "stack": 9900, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 0, "hole_cards": None},
+            {"seat": 1, "bot_id": "op", "stack": 9900, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 100, "hole_cards": None},
+        ],
+        "action_log": [{"seat": 0, "action": "small_blind", "amount": 50},
+                       {"seat": 1, "action": "big_blind", "amount": 100}],
+    }
+    base.update(overrides)
+    return base
+
+
+def test_warmup_returns_dict_with_action():
+    _legal(bot.decide({"type": "warmup"}))
+
+
+def test_preflop_premium_raises():
+    s = _state(your_cards=["As", "Ah"])
+    _legal(bot.decide(s))
+
+
+def test_preflop_trash_folds():
+    s = _state(your_cards=["7c", "2d"])
+    a = bot.decide(s)
+    _legal(a)
+    assert a["action"] in {"fold", "check"}
+
+
+def test_postflop_check_legal_when_can_check():
+    s = _state(street="flop", can_check=True, current_bet=0, amount_owed=0,
+               community_cards=["7s", "Td", "2h"], pot=300)
+    a = bot.decide(s)
+    _legal(a)
+
+
+def test_river_facing_bet():
+    s = _state(street="river", pot=4000,
+               community_cards=["7s", "Td", "2h", "Kc", "5d"],
+               current_bet=2000, min_raise_to=4000, amount_owed=2000,
+               your_cards=["2c", "3d"], your_stack=6000)
+    _legal(bot.decide(s))
+
+
+def test_short_stack_all_in_decision_path():
+    s = _state(your_stack=80, your_bet_this_street=20)
+    a = bot.decide(s)
+    _legal(a)
+
+
+def test_garbage_inputs():
+    for gs in [None, 42, "string", [], {}, {"random": True}, {"type": "weird"}]:
+        a = bot.decide(gs)
+        _legal(a)
+
+
+def test_sweep_streets_and_stacks():
+    rng = random.Random(0xC1A0DE)
+    for _ in range(80):
+        street = rng.choice(["preflop", "flop", "turn", "river"])
+        pot = rng.randint(50, 5000)
+        stack = rng.randint(20, 10000)
+        owed = rng.randint(0, min(stack, 500))
+        community_n = {"preflop": 0, "flop": 3, "turn": 4, "river": 5}[street]
+        ranks = "23456789TJQKA"
+        suits = "shdc"
+        used = set()
+        cards = []
+        while len(cards) < 2 + community_n:
+            c = rng.choice(ranks) + rng.choice(suits)
+            if c not in used:
+                used.add(c)
+                cards.append(c)
+        s = _state(street=street, community_cards=cards[2:], your_cards=cards[:2],
+                   pot=pot, your_stack=stack, amount_owed=owed,
+                   current_bet=owed, can_check=(owed == 0),
+                   min_raise_to=max(owed * 2, 100), your_bet_this_street=0)
+        _legal(bot.decide(s))
+
+
+def test_missing_optional_keys():
+    """If the engine drops optional keys, we still must respond legally."""
+    minimal = {"type": "action_request", "your_cards": ["As", "Kd"], "can_check": True}
+    _legal(bot.decide(minimal))
