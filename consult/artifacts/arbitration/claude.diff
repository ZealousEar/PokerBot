+"""Sandbox smoke run — exercises a submission inside the real engine sandbox
+container against a reference bot for a small number of hands. Catches
+runtime issues (timeout, OOM, missing data files, slow imports) that the
+AST-only validator cannot detect.
+
+The engine sandbox image is built from `ext/fullhouse-engine/sandbox/Dockerfile`.
+We launch two containers (hero + opponent), pipe newline-JSON game states from
+a local match driver, and check for crashes / timeouts / illegal actions.
+
+We invoke `docker run` directly rather than going through the engine's
+`sandbox/match.py` because match.py uses the legacy flag spelling
+`--no-new-privileges` which Docker 23+ rejects (it must be passed via
+`--security-opt=no-new-privileges:true`). The container resource limits
+match the engine's: `--network none --memory 768m --cpus 0.5 --read-only
+--no-new-privileges --user 1000:1000`.
+
+Usage:
+    python tools/smoke_run.py [--zip submissions/<name>.zip]
+                              [--opponent template] [--hands 200] [--seed 42]
+
+Returns:
+    exit 0  — match completed, no bot_errors, no timeouts, >= 90 % hands played
+    exit 1  — match ran but produced errors / timeouts / short hand count
+    exit 2  — prerequisite missing (no docker, missing submission, missing opponent)
+"""
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import zipfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+ENGINE = ROOT / "ext" / "fullhouse-engine"
+SANDBOX = ENGINE / "sandbox"
+IMAGE = os.environ.get("SANDBOX_IMAGE", "fullhouse-sandbox:latest")
+sys.path.insert(0, str(ENGINE))
+
+
+def _check_docker() -> bool:
+    return shutil.which("docker") is not None
+
+
+def _ensure_image() -> None:
+    res = subprocess.run(
+        ["docker", "image", "inspect", IMAGE],
+        capture_output=True,
+    )
+    if res.returncode == 0:
+        return
+    print(f"[smoke_run] building {IMAGE} from {SANDBOX}/Dockerfile", file=sys.stderr)
+    subprocess.run(
+        ["docker", "build", "-t", IMAGE, str(SANDBOX)],
+        check=True,
+    )
+
+
+def _prepare_mount(path: Path, label: str) -> Path:
+    mount = Path(tempfile.mkdtemp(prefix=f"smoke_{label}_"))
+    if path.is_dir():
+        # Copy contents (no symlinks)
+        for item in path.iterdir():
+            if item.is_dir():
+                shutil.copytree(item, mount / item.name, symlinks=False)
+            else:
+                shutil.copy(item, mount / item.name)
+    elif path.suffix == ".zip":
+        with zipfile.ZipFile(path) as zf:
+            zf.extractall(mount)
+    elif path.suffix == ".py":
+        shutil.copy(path, mount / "bot.py")
+    else:
+        raise SystemExit(f"unsupported submission type: {path}")
+    if not (mount / "bot.py").exists():
+        raise SystemExit(f"submission missing bot.py at root: {path}")
+    return mount
+
+
+class DockerBot:
+    """Subprocess wrapper for one bot container."""
+
+    def __init__(self, bot_id: str, mount_dir: Path):
+        self.bot_id = bot_id
+        self.errors = []
+        cmd = [
+            "docker", "run", "--rm", "-i",
+            "--network", "none",
+            "--memory", "768m",
+            "--memory-swap", "768m",
+            "--cpus", "0.5",
+            "--read-only",
+            "--security-opt", "no-new-privileges:true",
+            "--user", "1000:1000",
+            "--tmpfs", "/tmp:size=20m",
+            "-v", f"{mount_dir}:/bot:ro",
+            "-e", "ACTION_TIMEOUT=2",
+            "-e", "BOT_PATH=/bot/bot.py",
+            "-e", "BOT_DATA_DIR=/bot/data",
+            IMAGE,
+        ]
+        self._proc = subprocess.Popen(
+            cmd,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            text=True,
+        )
+
+    def act(self, state: dict) -> dict:
+        if self._proc.poll() is not None:
+            return {"action": "fold", "error": "container_dead"}
+        try:
+            self._proc.stdin.write(json.dumps(state) + "\n")
+            self._proc.stdin.flush()
+            line = self._proc.stdout.readline()
+            if not line:
+                return {"action": "fold", "error": "eof"}
+            obj = json.loads(line.strip())
+            if "error" in obj:
+                self.errors.append(obj["error"])
+            return obj
+        except Exception as e:
+            self.errors.append(str(e))
+            return {"action": "fold", "error": str(e)}
+
+    def warmup(self) -> None:
+        try:
+            self._proc.stdin.write(json.dumps({"type": "warmup"}) + "\n")
+            self._proc.stdin.flush()
+            self._proc.stdout.readline()
+        except Exception as e:
+            self.errors.append("warmup_failed: " + str(e))
+
+    def stop(self) -> None:
+        try:
+            self._proc.stdin.close()
+        except Exception:
+            pass
+        try:
+            self._proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            self._proc.kill()
+
+
+def run(hero_zip: Path, opp_dir: Path, hands: int, seed: int) -> int:
+    if not _check_docker():
+        print("[smoke_run] FAIL: docker not on PATH", file=sys.stderr)
+        return 2
+    _ensure_image()
+    from engine.game import PokerEngine, STARTING_STACK  # type: ignore
+
+    hero_mount = _prepare_mount(hero_zip, "hero")
+    opp_mount = _prepare_mount(opp_dir, "opp")
+    bots = {
+        "hero": DockerBot("hero", hero_mount),
+        "opp": DockerBot("opp", opp_mount),
+    }
+    for b in bots.values():
+        b.warmup()
+
+    stacks = {bid: STARTING_STACK for bid in bots}
+    bot_ids = list(bots.keys())
+    dealer = 0
+    hands_played = 0
+    errors_total = 0
+    try:
+        for h in range(hands):
+            alive = [b for b in bot_ids if stacks[b] > 0]
+            if len(alive) < 2:
+                break
+            engine = PokerEngine(
+                hand_id=f"smoke_h{h}",
+                bot_ids=alive,
+                dealer_seat=dealer % len(alive),
+                starting_stacks={b: stacks[b] for b in alive},
+                seed=seed + h if seed else None,
+            )
+            state = engine.start_hand()
+            steps = 0
+            while state.get("type") == "action_request":
+                seat = state["seat_to_act"]
+                action = bots[alive[seat]].act(state)
+                state = engine.apply_action(seat, action)
+                steps += 1
+                if steps > 1000:
+                    break
+            for bid, s in state["final_stacks"].items():
+                stacks[bid] = s
+            hands_played += 1
+            dealer += 1
+    finally:
+        for b in bots.values():
+            b.stop()
+            errors_total += len(b.errors)
+        shutil.rmtree(hero_mount, ignore_errors=True)
+        shutil.rmtree(opp_mount, ignore_errors=True)
+
+    summary = {
+        "n_hands": hands_played,
+        "expected_hands": hands,
+        "stacks": stacks,
+        "hero_errors": bots["hero"].errors,
+        "opp_errors_count": len(bots["opp"].errors),
+    }
+    print(json.dumps(summary, indent=2))
+
+    if hands_played < int(hands * 0.9):
+        print(f"[smoke_run] FAIL: only {hands_played}/{hands} hands played",
+              file=sys.stderr)
+        return 1
+    if bots["hero"].errors:
+        print(f"[smoke_run] FAIL: hero errors {bots['hero'].errors}",
+              file=sys.stderr)
+        return 1
+    print("[smoke_run] OK", file=sys.stderr)
+    return 0
+
+
+def main() -> int:
+    p = argparse.ArgumentParser()
+    p.add_argument("--zip", default="submissions/best_green.zip")
+    p.add_argument("--opponent", default="template")
+    p.add_argument("--hands", type=int, default=200)
+    p.add_argument("--seed", type=int, default=42)
+    args = p.parse_args()
+    submission = (ROOT / args.zip).resolve()
+    if not submission.is_file():
+        print(f"[smoke_run] FAIL: missing submission {submission}", file=sys.stderr)
+        return 2
+    opp = (ENGINE / "bots" / args.opponent).resolve()
+    if not opp.is_dir():
+        print(f"[smoke_run] FAIL: missing opponent {opp}", file=sys.stderr)
+        return 2
+    return run(submission, opp, args.hands, args.seed)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
