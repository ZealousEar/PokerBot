+"""Exercise the bot against engine-shaped corner cases the validator doesn't
+hit: side-pot scenarios, raise-below-min, raise-above-stack, malformed input,
+warmup repeated, all-in face."""
+import random
+
+from src import bot
+
+_VALID = {"fold", "check", "call", "raise", "all_in"}
+
+
+def _legal(a):
+    assert isinstance(a, dict), f"not a dict: {a!r}"
+    assert a.get("action") in _VALID, f"illegal action: {a!r}"
+    if a["action"] == "raise":
+        assert "amount" in a and isinstance(a["amount"], int)
+
+
+def test_all_in_face_short_stack_short_call():
+    state = {
+        "type": "action_request",
+        "hand_id": "edge_001",
+        "street": "preflop",
+        "seat_to_act": 0,
+        "pot": 1200,
+        "community_cards": [],
+        "current_bet": 800,
+        "min_raise_to": 1600,
+        "amount_owed": 800,
+        "can_check": False,
+        "your_cards": ["Js", "Ts"],
+        "your_stack": 250,  # shorter than owed
+        "your_bet_this_street": 0,
+        "players": [
+            {"seat": 0, "bot_id": "me", "stack": 250, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 0, "hole_cards": None},
+            {"seat": 1, "bot_id": "op", "stack": 9000, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 800, "hole_cards": None},
+        ],
+        "action_log": [
+            {"seat": 0, "action": "small_blind", "amount": 50},
+            {"seat": 1, "action": "big_blind", "amount": 100},
+            {"seat": 1, "action": "raise", "amount": 800},
+        ],
+    }
+    _legal(bot.decide(state))
+
+
+def test_raise_below_min_snapped():
+    # Hand that the bot wants to raise with should still land legal.
+    state = {
+        "type": "action_request",
+        "hand_id": "edge_002",
+        "street": "flop",
+        "seat_to_act": 0,
+        "pot": 600,
+        "community_cards": ["As", "Kh", "5d"],
+        "current_bet": 0,
+        "min_raise_to": 100,
+        "amount_owed": 0,
+        "can_check": True,
+        "your_cards": ["Ah", "Kd"],
+        "your_stack": 9700,
+        "your_bet_this_street": 0,
+        "players": [],
+        "action_log": [],
+    }
+    a = bot.decide(state)
+    _legal(a)
+    if a["action"] == "raise":
+        assert a["amount"] >= state["min_raise_to"]
+
+
+def test_raise_above_stack_becomes_all_in_or_legal():
+    state = {
+        "type": "action_request",
+        "hand_id": "edge_003",
+        "street": "preflop",
+        "seat_to_act": 0,
+        "pot": 5000,
+        "community_cards": [],
+        "current_bet": 4000,
+        "min_raise_to": 8000,
+        "amount_owed": 4000,
+        "can_check": False,
+        "your_cards": ["As", "Ah"],
+        "your_stack": 2000,  # smaller than min_raise increment
+        "your_bet_this_street": 0,
+        "players": [
+            {"seat": 0, "bot_id": "me", "stack": 2000, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 0, "hole_cards": None},
+            {"seat": 1, "bot_id": "op", "stack": 9000, "state": "active",
+             "is_folded": False, "is_all_in": False, "bet_this_street": 4000, "hole_cards": None},
+        ],
+        "action_log": [
+            {"seat": 0, "action": "small_blind", "amount": 50},
