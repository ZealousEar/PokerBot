+    _legal(bot.decide(state))
+
+
+def test_decide_under_2s_budget_synthetic():
+    """Decide must always return well under 2 s. Sweep many states."""
+    import time
+    rng = random.Random(7)
+    for _ in range(50):
+        street = rng.choice(["preflop", "flop", "turn", "river"])
+        community_n = {"preflop": 0, "flop": 3, "turn": 4, "river": 5}[street]
+        deck = [r + s for r in "23456789TJQKA" for s in "shdc"]
+        rng.shuffle(deck)
+        state = {
+            "type": "action_request",
+            "hand_id": "edge_perf",
+            "street": street,
+            "seat_to_act": 0,
+            "pot": rng.randint(100, 3000),
+            "community_cards": deck[:community_n],
+            "current_bet": rng.randint(0, 500),
+            "min_raise_to": 200,
+            "amount_owed": rng.randint(0, 500),
+            "can_check": rng.random() < 0.5,
+            "your_cards": deck[community_n:community_n + 2],
+            "your_stack": rng.randint(100, 10000),
+            "your_bet_this_street": 0,
+            "players": [
+                {"seat": 0, "bot_id": "me", "stack": 9000, "state": "active",
+                 "is_folded": False, "is_all_in": False, "bet_this_street": 0, "hole_cards": None},
+                {"seat": 1, "bot_id": "op", "stack": 9000, "state": "active",
+                 "is_folded": False, "is_all_in": False, "bet_this_street": 0, "hole_cards": None},
+            ],
+            "action_log": [],
+        }
+        t = time.monotonic()
+        _legal(bot.decide(state))
+        dt = time.monotonic() - t
+        assert dt < 1.5, f"decide() took {dt:.2f}s — over budget"
