+    board = list(state.get("community_cards", []))
+    dead = list(hero_cards) + list(villain_cards) + list(board)
+    deck = [eval7.Card(r + s) for r in RANKS for s in SUITS if r + s not in dead]
+    needed = 5 - len(board)
+    h = [eval7.Card(c) for c in hero_cards]
+    v = [eval7.Card(c) for c in villain_cards]
+    b = [eval7.Card(c) for c in board]
+    wins = 0.0
+    n = 0
+    for _ in range(trials):
+        rng.shuffle(deck)
+        runout = deck[:needed]
+        full = b + runout
+        hs = eval7.evaluate(h + full)
+        vs = eval7.evaluate(v + full)
+        if vs > hs:
+            wins += 1.0
+        elif vs == hs:
+            wins += 0.5
+        n += 1
+    return wins / n if n else 0.5
