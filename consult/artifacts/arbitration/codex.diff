+    # Source: [[Cepheus-Bowling-2015]]
+    strategy = np.zeros((buckets, hand_bins, 3), dtype=np.float32)
+    for b in range(buckets):
+        for h in range(hand_bins):
+            strength = h / max(1, hand_bins - 1)
+            texture = b / max(1, buckets - 1)
+            bet = min(0.75, max(0.05, 0.15 + 0.55 * strength - 0.10 * texture))
+            call = min(0.55, max(0.10, 0.35 + 0.25 * strength))
+            fold = max(0.0, 1.0 - bet - call)
+            total = bet + call + fold
+            strategy[b, h] = [fold / total, call / total, bet / total]
+
+    data_dir = ROOT / "data"
+    data_dir.mkdir(exist_ok=True)
+    np.savez_compressed(
+        data_dir / "flop_buckets.npz",
