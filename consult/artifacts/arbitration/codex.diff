+        metadata=np.array([f"buckets={buckets}", "deterministic_texture_hash"], dtype="<U80"),
+    )
+    np.savez_compressed(
+        data_dir / "flop_strategy.npz",
+        hand_bin_ids=hand_bin_ids,
+        strategy=strategy,
+        metadata=np.array([f"buckets={buckets}", f"hand_bins={hand_bins}"], dtype="<U80"),
+    )
+    print(f"wrote flop tables buckets={buckets} hand_bins={hand_bins}")
     return 0
 
 
